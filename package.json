{
  "name": "figma-kilo-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && node --check extension/background.js && node --check extension/connect.js && node --check extension/dom.js && node --check extension/download.js && node --check extension/layout.js && node --check extension/link.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.mjs",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
